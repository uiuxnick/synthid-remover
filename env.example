# Copy to .env.local (gitignored) and fill in.

# ── Database (Neon / Supabase Postgres) ──
# Pooled URL for runtime, direct URL for `prisma migrate`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/synthid?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/synthid?sslmode=require"

# ── Auth.js v5 ──
# openssl rand -base64 32
AUTH_SECRET=""
# Needed behind a proxy / self-hosted; Vercel sets it automatically.
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Redirect URI: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Encryption for secrets stored in AppConfig (SMTP password) ──
# openssl rand -base64 32  (must decode to exactly 32 bytes)
APP_ENCRYPTION_KEY=""

# ── SMTP fallback (used until an admin saves SMTP settings in the panel) ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Synthid Remover <no-reply@example.com>"
SMTP_SECURE="false"

# ── First admin bootstrap, consumed by `npm run db:seed` ──
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ── Added in later phases (provision early if you like) ──
RAZORPAY_KEY_ID=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# R2_ACCOUNT_ID="" R2_ACCESS_KEY_ID="" R2_SECRET_ACCESS_KEY="" R2_BUCKET=""

# Video cleanup needs ffmpeg + ffprobe on the server (not available on serverless hosts like Vercel).
# FFMPEG_PATH="/usr/bin/ffmpeg"
# FFPROBE_PATH="/usr/bin/ffprobe"
