{
  "name": "synthid-remover",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "(lsof -ti:3000 | xargs kill -9 2>/dev/null || true) && (next dev & sleep 2 && open http://localhost:3000)",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx scripts/verify-pipeline.mjs",
    "test:edge": "tsx scripts/test-edge-cases.mjs",
    "test:all": "tsx scripts/verify-pipeline.mjs && tsx scripts/test-edge-cases.mjs && vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.7.4",
    "@pilio/gemini-watermark-remover": "^1.0.31",
    "@prisma/client": "^5.22.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "next": "^14.2.5",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.4.6",
    "nodemailer": "^6.10.1",
    "omggif": "^1.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "playwright-core": "^1.64.1",
    "postcss": "^8.4.39",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.15",
    "typescript": "^5.5.2",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "@auth/core": "0.37.4"
  }
}
